// Simple math-only kernel for batch scoring (dot/dist/light/motion -> score).
#pragma kernel CSMain

StructuredBuffer<float4> Inputs;   // xyz: dot, dist, light, motion
RWStructuredBuffer<float2> Output;  // x: score, y: alert flag

float WeightDot;    // default 0.55
float WeightDist;   // default 0.25
float WeightLight;  // default 0.10
float WeightMotion; // default 0.10
float Threshold;    // default 0.60

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    float4 input = Inputs[i];

    float score = 0.0;
    score += input.x * WeightDot;    // dot
    score += input.y * WeightDist;   // distance normalized
    score += input.z * WeightLight;  // light level
    score += input.w * WeightMotion; // motion amount
    score = saturate(score);

    float alert = score >= Threshold ? 1.0 : 0.0;
    Output[i] = float2(score, alert);
}
